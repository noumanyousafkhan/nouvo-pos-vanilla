{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist-electron",
    "rootDir": "./electron",
    "types": ["node"],
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules"]
}
